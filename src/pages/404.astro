---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { url } from '~/lib/url';
---

<BaseLayout title="Not Found — Isn't It Alanis?" noindex>
  <section class="container-narrow py-32 text-center">
    <p class="fx-stamp eyebrow">404</p>
    <h1 class="fx-stamp mt-4 text-4xl md:text-6xl" style="--fx-delay: 80ms">Isn't it ironic?</h1>
    <p class="fx-stamp mt-6 max-w-md mx-auto text-bone/80" style="--fx-delay: 160ms">
      This page doesn't exist. Or maybe it just slipped right through you.
    </p>
    <div class="fx-stamp mt-10" style="--fx-delay: 240ms">
      <a href={url('/')} class="btn btn-primary">Back home</a>
    </div>
  </section>
</BaseLayout>
