---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { SITE, MEMBERS, DIFFERENTIATORS, SONGS } from '~/data/site';
import { url } from '~/lib/url';

const heroPhoto = '/img/web/hero.jpg';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'MusicGroup',
  name: SITE.name,
  alternateName: SITE.fullName,
  url: SITE.url,
  image: `${SITE.url}${url('/img/web/hero.jpg')}`,
  logo: `${SITE.url}${url('/img/logo.png')}`,
  genre: ['Alternative Rock', '90s Alternative', 'Tribute'],
  description: SITE.defaultDescription,
  email: SITE.email,
  sameAs: [SITE.socials.instagram, SITE.socials.facebook],
  member: MEMBERS.map(m => ({ '@type': 'Person', name: m.name, roleName: m.role })),
};
---

<BaseLayout
  title={`${SITE.name} — A Live Alanis Morissette Tribute | Long Island, NY`}
  description={SITE.defaultDescription}
  jsonLd={jsonLd}
>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-ink">
    <img
      src={url(heroPhoto)}
      alt="Isn't It Alanis? live"
      class="absolute inset-0 h-full w-full object-cover opacity-35"
      loading="eager"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-ink/60 via-ink/80 to-ink"></div>
    <div class="relative grain"></div>
    <div class="container-narrow relative py-28 md:py-40 text-center">
      <img
        src={url('/img/logo.png')}
        alt="Isn't It Alanis?"
        class="mx-auto h-32 md:h-48 w-auto"
        loading="eager"
      />
      <p class="mt-8 text-bone/85 max-w-2xl mx-auto leading-relaxed text-lg italic">
        Feel everything again — a live Alanis Morissette experience.
      </p>
      <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
        <a href={url('/booking')} class="btn btn-primary">Book the band</a>
        <a href={url('/songs')} class="btn btn-ghost">See the set list</a>
      </div>
    </div>
  </section>

  <!-- About strip -->
  <section class="container-narrow py-20 text-center">
    <p class="eyebrow">Who we are</p>
    <h2 class="mt-4 text-3xl md:text-5xl">More than nostalgia.</h2>
    <p class="mt-6 max-w-2xl mx-auto leading-relaxed text-bone/80">
      Based out of Long Island, NY, fronted by powerhouse vocalist <strong class="text-bone-soft">Sarah Glen</strong>, and backed
      by a seasoned live band, <em>Isn't It Alanis?</em> delivers more than nostalgia — it delivers connection, emotion,
      and a musical spectacle.
    </p>
    <div class="mt-8">
      <a href={url('/band')} class="text-sm font-semibold uppercase tracking-[0.18em] text-brick-soft hover:underline underline-offset-4">
        Meet the band →
      </a>
    </div>
  </section>

  <!-- Differentiators -->
  <section class="bg-ink-2 border-y border-bone/10 py-20">
    <div class="container-narrow">
      <div class="text-center">
        <p class="eyebrow">What makes us different</p>
        <h2 class="mt-4 text-3xl md:text-4xl">The show, the way it should be.</h2>
      </div>
      <div class="mt-14 grid sm:grid-cols-2 lg:grid-cols-5 gap-6">
        {DIFFERENTIATORS.map(d => (
          <div class="border border-bone/10 p-6 bg-ink/40">
            <h3 class="text-lg text-brick-soft">{d.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-bone/80">{d.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Watch us -->
  <section class="container-narrow py-20">
    <div class="text-center">
      <p class="eyebrow">Hear &amp; see us</p>
      <h2 class="mt-4 text-3xl md:text-4xl">Watch us live.</h2>
    </div>
    <div class="mt-12 grid md:grid-cols-2 gap-6">
      {SITE.youtube.map(v => (
        <div class="relative aspect-video bg-ink-2 border border-bone/10">
          <iframe
            class="absolute inset-0 h-full w-full"
            src={`https://www.youtube.com/embed/${v.id}`}
            title={v.label}
            loading="lazy"
            allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            referrerpolicy="strict-origin-when-cross-origin"
            allowfullscreen
          ></iframe>
        </div>
      ))}
    </div>
  </section>

  <!-- Set list teaser -->
  <section class="bg-ink-2 border-y border-bone/10 py-20">
    <div class="container-narrow text-center">
      <p class="eyebrow">What we play</p>
      <h2 class="mt-4 text-3xl md:text-4xl">From the hits to the deep cuts.</h2>
      <div class="mt-10 flex flex-wrap justify-center gap-x-6 gap-y-2 text-bone/85 max-w-3xl mx-auto">
        {SONGS.map(s => <span class="text-sm italic">{s}</span>)}
      </div>
      <div class="mt-10">
        <a href={url('/songs')} class="btn btn-ghost">Full set list</a>
      </div>
    </div>
  </section>

  <!-- Booking CTA -->
  <section class="container-narrow py-24 text-center">
    <p class="eyebrow">Book the band</p>
    <h2 class="mt-4 text-3xl md:text-4xl">Bring the show to your stage.</h2>
    <p class="mt-6 max-w-xl mx-auto text-bone/80 leading-relaxed">
      Theaters, festivals, private events. Based in Long Island, NY — available across the Tristate area and beyond.
    </p>
    <div class="mt-10">
      <a href={url('/booking')} class="btn btn-primary">Get in touch</a>
    </div>
  </section>
</BaseLayout>
