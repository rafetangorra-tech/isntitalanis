---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { SITE, bookingMailto } from '~/data/site';
import { url } from '~/lib/url';
---

<BaseLayout
  title={`Booking — ${SITE.name}`}
  description={`Book Isn't It Alanis? — a live Alanis Morissette tribute out of Long Island, NY. Email ${SITE.email}.`}
>
  <section class="container-narrow py-16 md:py-24">
    <div class="text-center">
      <p class="fx-stamp eyebrow">Booking</p>
      <h1 class="fx-stamp mt-4 text-4xl md:text-6xl" style="--fx-delay: 80ms">Book the band.</h1>
      <p class="fx-stamp mt-6 max-w-2xl mx-auto text-bone/80 leading-relaxed" style="--fx-delay: 160ms">
        Theaters, festivals, private events. Based out of Long Island, NY — available across the Tristate area and beyond.
      </p>
    </div>

    <div class="mt-14 grid md:grid-cols-2 gap-6">
      <div class="fx-tape-reveal border border-bone/10 bg-ink-2 p-8">
        <p class="eyebrow !text-brick-soft">Email</p>
        <a
          href={bookingMailto()}
          class="mt-3 block text-xl text-bone-soft hover:text-brick-soft break-all"
        >
          {SITE.email}
        </a>
        <p class="mt-4 text-sm text-bone/70 leading-relaxed">
          Tell us the event date, venue or city, and the rough vibe you're going for. We'll get back fast.
        </p>
        <a href={bookingMailto()} class="mt-6 btn btn-primary">Open a booking email</a>
      </div>

      <div class="fx-tape-reveal border border-bone/10 bg-ink-2 p-8" style="--fx-delay: 140ms">
        <p class="eyebrow !text-brick-soft">Follow & DM</p>
        <ul class="mt-3 space-y-3 text-bone-soft">
          <li>
            <a href={SITE.socials.instagram} target="_blank" rel="noopener" class="hover:text-brick-soft">
              Instagram — {SITE.igHandle}
            </a>
          </li>
          <li>
            <a href={SITE.socials.facebook} target="_blank" rel="noopener" class="hover:text-brick-soft">
              Facebook
            </a>
          </li>
        </ul>
        <p class="mt-6 text-sm text-bone/70 leading-relaxed">
          For show clips, dates, and announcements.
        </p>
      </div>
    </div>

    <div class="fx-tape-reveal mt-14 border border-bone/10 bg-ink-2 p-8" style="--fx-delay: 80ms">
      <p class="eyebrow !text-brick-soft">What you get</p>
      <ul class="mt-4 grid sm:grid-cols-2 gap-x-8 gap-y-3 text-bone/85 leading-relaxed">
        <li>— A six-piece lineup with live vocals and instruments</li>
        <li>— A deep set spanning hits, deep cuts, and fan favorites</li>
        <li>— Embellished arrangements for the live experience</li>
        <li>— Background visuals and a fashionable stage presence</li>
        <li>— Experienced players who keep the show fun and flexible</li>
        <li>— No backing tracks. Ever.</li>
      </ul>
    </div>
  </section>
</BaseLayout>
