---
import { SITE, NAV } from '~/data/site';
import { url } from '~/lib/url';
const year = new Date().getFullYear();
---

<footer class="bg-ink-2 text-bone/80 border-t border-bone/10 mt-24">
  <div class="container-narrow py-14 grid gap-10 md:grid-cols-12">
    <div class="md:col-span-6">
      <div class="flex items-center gap-3">
        <img src={url('/img/logo.png')} alt="Isn't It Alanis?" width="48" height="48" class="h-12 w-12" />
        <span class="font-display tracking-wider text-bone-soft">ISN'T IT ALANIS?</span>
      </div>
      <p class="mt-4 text-sm leading-relaxed max-w-md">
        {SITE.defaultDescription}
      </p>
      <p class="mt-3 text-xs uppercase tracking-[0.18em] text-bone/60">{SITE.basedIn}</p>
    </div>

    <div class="md:col-span-3">
      <p class="eyebrow !text-brick-soft">Explore</p>
      <ul class="mt-3 space-y-2 text-sm">
        {NAV.map(n => (
          <li><a href={url(n.href)} class="hover:text-brick-soft transition-colors">{n.label}</a></li>
        ))}
      </ul>
    </div>

    <div class="md:col-span-3">
      <p class="eyebrow !text-brick-soft">Follow</p>
      <ul class="mt-3 space-y-2 text-sm">
        <li><a href={`mailto:${SITE.email}`} class="hover:text-brick-soft transition-colors break-all">{SITE.email}</a></li>
        <li><a href={SITE.socials.instagram} class="hover:text-brick-soft transition-colors" rel="noopener" target="_blank">Instagram</a></li>
        <li><a href={SITE.socials.facebook} class="hover:text-brick-soft transition-colors" rel="noopener" target="_blank">Facebook</a></li>
      </ul>
    </div>
  </div>

  <div class="border-t border-bone/10">
    <div class="container-narrow py-5 text-xs text-bone/50 flex flex-col md:flex-row gap-2 justify-between items-center">
      <span>© {year} Isn't It Alanis?</span>
      <span>{SITE.tagline}</span>
    </div>
  </div>
</footer>
