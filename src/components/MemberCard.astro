---
import { url } from '~/lib/url';

interface Props {
  name: string;
  role: string;
  imageFile: string;
  index?: number;
}
const { name, role, imageFile, index = 0 } = Astro.props;
---

<div
  class="group bg-ink-2 border border-bone/10 hover:border-brick fx-tape-reveal"
  style={`--fx-delay: ${index * 80}ms`}
>
  <div class="aspect-[4/5] overflow-hidden bg-charcoal">
    <img
      src={url(`/img/members/${imageFile}`)}
      alt={`${name}, ${role}`}
      loading="lazy"
      class="h-full w-full object-cover object-top transition-transform duration-500 group-hover:scale-105"
    />
  </div>
  <div class="p-5">
    <p class="eyebrow">{role}</p>
    <h3 class="mt-1 text-xl tracking-tight text-bone-soft">{name}</h3>
  </div>
</div>
